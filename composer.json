{
  "name": "self-ordering/backend",
  "type": "project",
  "description": "Laravel API backend for the family self-ordering mini program.",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0",
    "predis/predis": "^2.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "php artisan test",
    "lint": "pint --test"
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.33"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
